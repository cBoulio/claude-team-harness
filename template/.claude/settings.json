{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git -C:*)",
      "Bash({{PYTHON}} .claude/hooks/log_issue.py:*)",
      "Bash({{PYTHON}} .claude/hooks/render_research.py:*)",
      "Bash({{PYTHON}} scripts/add-app.py:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git show:*)",
      "PowerShell(git -C:*)",
      "PowerShell({{PYTHON}} .claude/hooks/log_issue.py:*)",
      "PowerShell({{PYTHON}} .claude/hooks/render_research.py:*)",
      "PowerShell({{PYTHON}} scripts/add-app.py:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.dev.vars)",
      "Read(./.claude/settings.local.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_commands.py\"", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "async": true }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/render_research.py\"", "timeout": 60 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "async": true }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "async": true }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "async": true }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "async": true }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "async": true }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_event.py\"", "timeout": 15 }
        ]
      }
    ]
  }
}
